[Unit]
Description=The Harness persistent Playwright browser
After=graphical-session-pre.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
Environment="PYTHONPATH=@REPO_ROOT@"
Environment="PLAYWRIGHT_BROWSERS_PATH=@REPO_ROOT@/.playwright-browsers"
Environment="THE_HARNESS_MACHINE_ROOT=%h/.the_harness_assistant"
ExecStart="@REPO_ROOT@/.venv/bin/python" -m the_harness.browser_process
Restart=on-failure
RestartSec=2
KillMode=mixed
TimeoutStopSec=45

[Install]
WantedBy=graphical-session.target
